+    // alimentacao direta pura (TCC), so da trajetoria do alvo
+    if (_ff > 0) {
+        if (_ff_primeiro) {
+            _w_t_ant = ang_vel_body_feedforward;
+            _ff_primeiro = false;
+        }
+        for (uint8_t i = 0; i < 3; i++) {
+            const float b = _ff_b.get()[i];
+            if (is_positive(b)) {
+                const float a_t = (ang_vel_body_feedforward[i] - _w_t_ant[i]) / _dt;
+                motor_out[i] += (a_t + _ff_a * ang_vel_body_feedforward[i]) / b;
+            }
+        }
+        _w_t_ant = ang_vel_body_feedforward;
+    }
+
     return motor_out;
 }
 
